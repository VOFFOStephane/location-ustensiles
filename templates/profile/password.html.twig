{% extends 'base.html.twig' %}
{% block title %}Changer mot de passe{% endblock %}

{% block body %}
    <div class="kr-main">
        <div class="auth">
            <div class="auth-card">
                <h1 class="auth-title">Changer mon mot de passe</h1>
                <p class="auth-subtitle">Sécurise ton compte.</p>

                {{ form_start(form, { attr: { class: 'form' } }) }}

                <div class="field">
                    {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'field__label'}}) }}
                    {{ form_widget(form.currentPassword, {'attr': {'class': 'field__input'}}) }}
                    {{ form_errors(form.currentPassword) }}
                </div>

                <div class="field">
                    {{ form_label(form.newPassword, null, {'label_attr': {'class': 'field__label'}}) }}
                    {{ form_widget(form.newPassword, {'attr': {'class': 'field__input'}}) }}
                    {{ form_errors(form.newPassword) }}
                </div>

                <button class="btn btn--primary" type="submit">Changer</button>

                <p class="hint auth-foot">
                    <a href="{{ path('profile_show') }}">Retour au profil</a>
                </p>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
