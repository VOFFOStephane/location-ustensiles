{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="kr-main">
        <div class="auth">
            <div class="auth-card">
                <h1 class="auth-title">Connexion</h1>
                <p class="auth-subtitle">Connecte-toi pour accéder à ton panier et tes réservations.</p>

                {% if error %}
                    <div class="flash flash-error" data-flash>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="flash flash-info" data-flash>
                        Tu es déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                {% endif %}

                <form method="post" class="form">
                    <div class="field">
                        <label class="field__label" for="inputEmail">Email</label>
                        <input
                            class="field__input"
                            type="email"
                            value="{{ last_username }}"
                            name="email"
                            id="inputEmail"
                            autocomplete="email"
                            required
                            autofocus
                            placeholder="email@exemple.com"
                        >
                    </div>

                    <div class="field">
                        <label class="field__label" for="inputPassword">Mot de passe</label>
                        <input
                            class="field__input"
                            type="password"
                            name="password"
                            id="inputPassword"
                            autocomplete="current-password"
                            required
                            placeholder="••••••••"
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="field auth-check">
                        <input class="auth-check__box" type="checkbox" name="_remember_me" id="rememberMe">
                        <label for="rememberMe" class="auth-check__text">Se souvenir de moi</label>
                    </div>

                    <button class="btn btn--primary" type="submit">Se connecter</button>

                    <p class="hint auth-foot">
                        Pas de compte ?
                        <a href="{{ path('app_register') }}">Créer un compte</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
