<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}KitchenRent{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍳</text></svg>">

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body>

<header class="kr-header">
    <div class="kr-header__left">
        <a class="kr-brand" href="{{ path('product_index') }}">
            <span class="kr-logo">▣</span>
            <span>
                <strong class="kr-brand__name">KitchenRent</strong><br>
                <small class="kr-brand__tag">Location d'ustensiles</small>
            </span>
        </a>
    </div>

    <nav class="kr-nav">
        <a class="kr-nav__link {% if app.request.attributes.get('_route') starts with 'product_' %}is-active{% endif %}"
           href="{{ path('product_index') }}">
            Catalogue
        </a>

        {% if app.user %}
            <a class="kr-nav__link {% if app.request.attributes.get('_route') starts with 'reservation_' %}is-active{% endif %}"
               href="{{ path('reservation_index') }}">
                Mes réservations
            </a>

            <a class="kr-icon-link {% if app.request.attributes.get('_route') starts with 'cart_' %}is-active{% endif %}"
               href="{{ path('cart_index') }}"
               aria-label="Panier">
                🛒
            </a>

            <a class="kr-nav__link {% if app.request.attributes.get('_route') starts with 'profile_' %}is-active{% endif %}"
               href="{{ path('profile_show') }}">
                Profil
            </a>

            <div class="kr-user">
                <span class="kr-user__badge">
                    {{ (app.user.firstname is defined and app.user.firstname) ? app.user.firstname|slice(0,1) : 'U' }}
                    {{ (app.user.lastname is defined and app.user.lastname) ? app.user.lastname|slice(0,1) : '' }}
                </span>

                <span class="kr-user__name">
                    {{ app.user.firstname is defined and app.user.firstname ? app.user.firstname : app.user.email }}
                </span>

                <a class="kr-icon-link" href="{{ path('app_logout') }}" title="Déconnexion" aria-label="Déconnexion">⎋</a>
            </div>
        {% else %}
            <a class="kr-nav__link {% if app.request.attributes.get('_route') == 'app_login' %}is-active{% endif %}"
               href="{{ path('app_login') }}">
                Connexion
            </a>
            <a class="kr-nav__link {% if app.request.attributes.get('_route') == 'app_register' %}is-active{% endif %}"
               href="{{ path('app_register') }}">
                Inscription
            </a>
        {% endif %}
    </nav>
</header>


{# FLASH MESSAGES #}
<div class="kr-flashes">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ type }}" data-flash>
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>


<main class="kr-main">
    {% block body %}{% endblock %}
</main>


<script>
    // auto-hide des flash messages
    setTimeout(() => {
        document.querySelectorAll('[data-flash]').forEach(el => {
            el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            el.style.opacity = '0';
            el.style.transform = 'translateY(-6px)';
            setTimeout(() => el.remove(), 450);
        });
    }, 4000);
</script>

</body>
</html>
